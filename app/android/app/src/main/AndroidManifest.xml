<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup: 켜 둔다(10/22). 담은 과목·저장한 시간표·출발 지점이 사용자의 기기 백업(Google 계정)에 들어가 새 폰에서 이어질 수 있다.
         개발자는 그 백업을 볼 수 없다. 처리방침에 적을 내용은 docs/app.md '기기 백업' -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <!-- 앱 화면(웹뷰 하나, AppActivity.java). 런처 아이콘은 아래 별칭 둘이고, 위젯·시간표 링크는 이 화면으로 바로 온다 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".AppActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- 시간표 링크로 앱 열기(App Links, 10/30). 공유한 링크 https://archi142857.github.io/tt-wizard/#t=… 를 앱이 깔린 폰에서 누르면 이 앱이 연다
                 (화면은 native.js 의 TTW_APP.launchUrl·'ttw:open-url' 로 받는다). 경로는 웹 앱 첫 주소 하나만(path): 같은 사이트의 실측 페이지(field/)·
                 고지문·처리방침 같은 다른 페이지는 브라우저로 열려야 한다. '#' 뒤는 맞춰 보지 않는다.
                 확인 파일은 https://archi142857.github.io/.well-known/assetlinks.json (사용자 사이트 저장소 archi142857.github.io, docs/app.md '시간표 링크로 앱 열기').
                 그 파일이 없으면 안드로이드 12 이상은 브라우저로 연다(설정 > 앱 > TT Wizard > 기본으로 열기 에서 손으로 켤 수는 있다) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="archi142857.github.io" android:path="/tt-wizard/" />
            </intent-filter>

        </activity>

        <!-- 런처 아이콘(update108, 디자인 125판 계절 아이콘, LauncherIcon.java): 별칭 둘 가운데 하나만 켜져 앱 서랍·홈 화면에 보인다.
             .MainActivity 는 update108 전 앱 화면의 이름 그대로라 업데이트해도 홈 화면에 둔 아이콘이 남는다(이 이름은 바꾸지 않는다).
             .MainActivityXmas 는 12월(기기 날짜) 한 달, 안드로이드 11 이상에서 앱이 안 보일 때 켜진다. 둘 다 AppActivity 를 연다 -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".AppActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityXmas"
            android:targetActivity=".AppActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_xmas"
            android:roundIcon="@mipmap/ic_launcher_xmas_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 홈 화면 위젯 셋(10/30, docs/app.md '홈 화면 위젯'): 다음 수업 2×2, 오늘 수업 4×2~4×4, 주간 시간표 4×4.
             자료는 화면이 넘긴 대표 시간표(WidgetPlugin → SharedPreferences), 그리기는 WidgetViews. 시스템만 보내는 방송이라 exported="false" -->
        <receiver
            android:name=".NextClassWidget"
            android:exported="false"
            android:label="@string/widget_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver
            android:name=".TodayWidget"
            android:exported="false"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".WeekWidget"
            android:exported="false"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <!-- 폰 알림의 알람을 받는 곳(update109, Notifier). 밖에서 부르지 못한다 -->
        <receiver android:name=".NotifyReceiver" android:exported="false" />

        <!-- 위젯을 다시 그리는 때: 부정확 알람(수업 시작·끝, 0시. 정확한 알람 권한 없음), 기기 시각·시간대가 바뀔 때, 앱을 업데이트했을 때.
             받을 때마다 계절 앱 아이콘도 맞춘다(LauncherIcon) -->
        <receiver
            android:name=".DayMapWidget"
            android:exported="false"
            android:label="@string/widget_map_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_map_info" />
        </receiver>
        <receiver
            android:name=".WidgetUpdater"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 안드로이드 9 이하에서 시간표 이미지를 사진(Pictures/TT Wizard)에 저장할 때만 묻는다(디자인 79판 '모든 기기에 둔다', ImagePlugin.java).
         10 이상은 MediaStore 에 제 파일을 더해서 권한이 없다. 거절해도 공유 시트로는 내보낼 수 있다 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- 폰 알림(update109, 법무 11/13): 안드로이드 13 이상에서 화면의 스위치를 처음 켤 때만 묻는다. 정확한 알람·부팅 권한은 쓰지 않는다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 공유 카드의 바로 보내기(update80, SharePlugin.java): 안드로이드 11 이상은 여기 적은 앱만 보인다(깔렸는지, 그 앱 아이콘·이름, 받는 화면).
         카카오톡·인스타그램과 문자 앱(smsto: 를 받는 앱, 기본 문자 앱을 찾으려고)만. 모든 앱을 보는 QUERY_ALL_PACKAGES 는 쓰지 않는다.
         단추를 더하면 SharePlugin.TARGETS 와 여기를 함께 고친다 -->
    <queries>
        <package android:name="com.kakao.talk" />
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- 캘린더 파일(.ics)을 여는 앱(update104, SharePlugin.calendarApps) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="text/calendar" />
        </intent>
    </queries>
</manifest>
