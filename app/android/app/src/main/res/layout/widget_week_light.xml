<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/widget_themes.py 가 layout/widget_week.xml 에서 옮겨 만든 'light' 한 벌이다(update78, 위젯이 앱 테마로 그린다). 여기를 고치지 말고 원본을 고친 뒤 다시 만든다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/w_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_band_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/w_title"
            style="@style/TTWWidget.BandTitle.Light"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/w_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_grid_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/w_grid_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone" />
            <FrameLayout
                android:id="@+id/w_hits"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <include
            android:id="@+id/w_empty"
            layout="@layout/widget_empty_light"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
