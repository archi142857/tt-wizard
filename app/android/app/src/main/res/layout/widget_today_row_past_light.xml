<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/widget_themes.py 가 layout/widget_today_row_past.xml 에서 옮겨 만든 'light' 한 벌이다(update78, 위젯이 앱 테마로 그린다). 여기를 고치지 말고 원본을 고친 뒤 다시 만든다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/r_mark"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:alpha="0.4"
        android:background="@drawable/widget_mark_item0_light"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/r_name"
            style="@style/TTWWidget.RowName.Light"
            android:textColor="@color/widget_text3_light"
            android:textStyle="normal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/r_late"
                style="@style/TTWWidget.RowSub.Light"
                android:layout_width="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/widget_danger_light"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/r_sub"
                style="@style/TTWWidget.RowSub.Light"
                android:layout_width="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/r_time"
            style="@style/TTWWidget.RowTime.Light"
            android:textColor="@color/widget_text3_light" />

        <TextView
            android:id="@+id/r_now"
            style="@style/TTWWidget.Tag.Light"
            android:layout_marginTop="3dp"
            android:text="@string/w_now_tag"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
