<?xml version="1.0" encoding="utf-8"?>
<!-- 다음 수업 위젯(2×2, 10/30). 위는 무슨 수업인지(과목명·시각·강의실), 아래는 이 위젯의 중심인 언제 나서는지를 크게(update70, 사용자: "출발, 걷기 이거 좀 더
     내용의 중심이 되도록 크고 잘 보이게"): '14:44 출발'(t-h2 20 굵게 accent-text)과 그 아래 '걷기 16분'. 글과 보이기는 WidgetViews.next 가 정한다.
     눌러서 앱의 그 요일 동선 지도(화면이 주소의 route 를 읽기 전에는 내 시간표) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_mark_item0"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_caption"
            style="@style/TTWWidget.Caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_name"
            style="@style/TTWWidget.Title"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/w_time"
            style="@style/TTWWidget.Body"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/w_place"
            style="@style/TTWWidget.Body" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <TextView
            android:id="@+id/w_hero"
            style="@style/TTWWidget.Hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_hero_sub"
                style="@style/TTWWidget.HeroSub"
                android:layout_width="wrap_content" />

            <TextView
                android:id="@+id/w_late"
                style="@style/TTWWidget.HeroSub"
                android:layout_width="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/widget_danger"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/w_empty"
        layout="@layout/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
