<?xml version="1.0" encoding="utf-8"?>
<!-- 다음 수업 위젯(2×2, 10/30). 글과 보이기는 WidgetViews.next 가 정한다. 눌러서 앱의 내 시간표 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_mark_item0"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_caption"
            style="@style/TTWWidget.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_name"
        style="@style/TTWWidget.Title"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/w_time"
        style="@style/TTWWidget.Body"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/w_place"
        style="@style/TTWWidget.Body" />

    <TextView
        android:id="@+id/w_msg"
        style="@style/TTWWidget.Message"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_foot"
            style="@style/TTWWidget.Foot"
            android:layout_width="wrap_content" />

        <TextView
            android:id="@+id/w_late"
            style="@style/TTWWidget.Foot"
            android:layout_width="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/widget_danger"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
