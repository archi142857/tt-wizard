<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르는 화면의 다음 수업 미리 보기(안드로이드 12 이상 previewLayout). 지어낸 보기다. 모양은 widget_next(update70 의 큰 출발 줄) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_mark_item1"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/TTWWidget.Caption"
            android:text="@string/w_next" />
    </LinearLayout>

    <TextView
        style="@style/TTWWidget.Title"
        android:layout_marginTop="4dp"
        android:text="@string/w_preview_name" />

    <TextView
        style="@style/TTWWidget.Body"
        android:layout_marginTop="2dp"
        android:text="@string/w_preview_time" />

    <TextView
        style="@style/TTWWidget.Body"
        android:text="@string/w_preview_place" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="4dp" />

    <TextView
        style="@style/TTWWidget.Hero"
        android:text="@string/w_preview_hero" />

    <TextView
        style="@style/TTWWidget.HeroSub"
        android:layout_marginTop="2dp"
        android:text="@string/w_preview_hero_sub" />
</LinearLayout>
