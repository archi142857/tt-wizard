<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르는 화면의 오늘 수업 미리 보기(안드로이드 12 이상 previewLayout). 지어낸 보기다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/TTWWidget.Heading"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/w_preview_today" />

        <TextView
            style="@style/TTWWidget.Caption"
            android:text="@string/w_preview_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_mark_item1"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TTWWidget.RowName"
                android:text="@string/w_preview_name" />

            <TextView
                style="@style/TTWWidget.RowSub"
                android:layout_marginTop="3dp"
                android:text="@string/w_preview_place" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                style="@style/TTWWidget.RowTime"
                android:text="@string/w_preview_time" />

            <TextView
                style="@style/TTWWidget.Tag"
                android:layout_marginTop="3dp"
                android:text="@string/w_now_tag" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_mark_item2"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TTWWidget.RowName"
                android:text="@string/w_preview_name2" />

            <TextView
                style="@style/TTWWidget.RowSub"
                android:layout_marginTop="3dp"
                android:text="@string/w_preview_sub2" />
        </LinearLayout>

        <TextView
            style="@style/TTWWidget.RowTime"
            android:layout_marginStart="8dp"
            android:text="@string/w_preview_time2" />
    </LinearLayout>
</LinearLayout>
