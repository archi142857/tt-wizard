<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/widget_themes.py 가 layout/widget_today.xml 에서 옮겨 만든 'dark' 한 벌이다(update78, 위젯이 앱 테마로 그린다). 여기를 고치지 말고 원본을 고친 뒤 다시 만든다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/w_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_band_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/w_date"
            style="@style/TTWWidget.BandTitle.Dark"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_title"
            style="@style/TTWWidget.BandText.Dark"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/w_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/w_sub"
            style="@style/TTWWidget.Body.Dark"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
        <include
            android:id="@+id/w_empty"
            layout="@layout/widget_empty_dark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
