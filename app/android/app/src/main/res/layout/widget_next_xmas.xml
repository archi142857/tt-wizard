<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/widget_themes.py 가 layout/widget_next.xml 에서 옮겨 만든 'xmas' 한 벌이다(update78, 위젯이 앱 테마로 그린다). 여기를 고치지 말고 원본을 고친 뒤 다시 만든다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_xmas"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/w_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_band_xmas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="-1dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_dot_ring_xmas"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_mark_item0_xmas"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_caption"
            style="@style/TTWWidget.BandTitle.Xmas"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/w_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/w_lecture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_name"
                    style="@style/TTWWidget.Title.Xmas"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/w_time"
                    style="@style/TTWWidget.Body.Xmas"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/w_place"
                    style="@style/TTWWidget.Body.Xmas" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="4dp" />

            <LinearLayout
                android:id="@+id/w_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_block_xmas"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/w_hero"
                    style="@style/TTWWidget.Hero.Xmas" />

                <LinearLayout
                    android:id="@+id/w_hero_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/w_hero_sub"
                        style="@style/TTWWidget.HeroSub.Xmas"
                        android:layout_width="wrap_content" />

                    <TextView
                        android:id="@+id/w_late"
                        style="@style/TTWWidget.HeroSub.Xmas"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/widget_danger_xmas"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/w_empty"
            layout="@layout/widget_empty_xmas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
