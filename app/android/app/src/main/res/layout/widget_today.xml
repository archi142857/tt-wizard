<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 수업 위젯(4×2, 4×4 까지 늘린다, 10/30). 행은 WidgetViews.today 가 widget_today_row 로 넣는다(높이만큼). 눌러서 앱의 내 시간표 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_date"
            style="@style/TTWWidget.Heading"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_title"
            style="@style/TTWWidget.Caption"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w_msg"
        style="@style/TTWWidget.Message"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_sub"
        style="@style/TTWWidget.Body"
        android:layout_marginTop="4dp"
        android:visibility="gone" />
</LinearLayout>
