<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/widget_themes.py 가 layout/widget_empty.xml 에서 옮겨 만든 'xmas' 한 벌이다(update78, 위젯이 앱 테마로 그린다). 여기를 고치지 말고 원본을 고친 뒤 다시 만든다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/w_empty_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_timetable_xmas" />

    <TextView
        android:id="@+id/w_msg"
        style="@style/TTWWidget.Message.Xmas"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/w_msg_sub"
        style="@style/TTWWidget.Body.Xmas"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_action"
        style="@style/TTWWidget.Action.Xmas"
        android:layout_marginTop="8dp"
        android:text="@string/w_open_mine"
        android:visibility="gone" />
</LinearLayout>
