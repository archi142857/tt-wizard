<?xml version="1.0" encoding="utf-8"?>
<!-- 동선 지도 위젯(4×2, 4×4 까지 늘린다, update71). 맨 위 머리 띠(update78, 디자인 106판: 앱 테마의 bg 단색에 날짜 13 굵게와 오른쪽 그날 걷기 합 12, 좌우 10),
     그 아래 몸(card, 띠 아래 6·좌우·아래 10)에 지도 그림. 지도는 그림(DayMapBitmap)이라 앱 테마가 기본(기기 설정)이면 라이트·다크 두 장을 늘 같이 넣고,
     어느 쪽을 보일지는 이 파일과 layout-night 판이 정한다(주간 시간표 위젯과 같다. 코드는 두 그림의 보이기를 건드리지 않는다). 다크(밤) 판: 다크 그림을 보인다. 라이트 판은 layout/widget_map.xml.
     출처(수치지형도·OpenStreetMap)는 지도 오른쪽 아래 글. 눌러서 앱의 그 요일 동선 지도.
     고른 라이트·다크·크리스마스 한 벌은 scripts/widget_themes.py 가 layout/widget_map.xml 로 만들고(widget_map_light 등) 그 한 벌의 그림 한 장을 w_map_light 에 넣는다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/w_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_band"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/w_title"
            style="@style/TTWWidget.BandTitle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_sum"
            style="@style/TTWWidget.BandText"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/w_map"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_map_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_map_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="visible" />

            <TextView
                android:id="@+id/w_attr"
                style="@style/TTWWidget.MapAttr"
                android:layout_gravity="bottom|end"
                android:text="@string/w_map_attr" />
        </FrameLayout>

        <include
            android:id="@+id/w_empty"
            layout="@layout/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
