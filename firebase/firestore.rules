rules_version = '2';

// TT Wizard 서버 규칙 (Cloud Firestore)
//
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 그대로 붙여 넣고 '게시'를 누르면 된다.
// 어떤 자료를 어디에 두는지는 docs/account.md 에 적어 두었다.
//
// 큰 원칙은 세 가지다.
//   1. 내 자료는 나만 읽고 쓴다.
//   2. 남에게 보이는 건 친구를 찾을 때 쓰는 닉네임과 번호, 그리고 친구에게만 열어 둔 시간표 사본뿐이다.
//   3. 남의 자료를 고칠 수 있는 사람은 관리자뿐이고, 관리자도 번호를 바꿔 주는 일만 할 수 있다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 자주 쓰는 확인 =====

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 관리자는 콘솔에서 admins/{uid} 문서를 직접 만들어 준 계정이다. 앱으로는 아무도 관리자가 될 수 없다.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 계정 번호: 1~9로 시작하는 여섯 자리. 계정마다 하나이고 닉네임을 바꿔도 그대로다.
    function isNumber(n) {
      return n is string && n.matches('^[1-9][0-9]{5}$');
    }

    // 예전 번호: 계정 번호가 생기기 전에는 '닉네임#네 자리'로 사람을 구분했다.
    function isOldTag(t) {
      return t is string && t.matches('^[0-9]{4}$');
    }

    // 이번 쓰기가 끝난 뒤의 모습. 프로필과 번호처럼 한 번에 같이 쓰는 문서끼리 서로 맞는지 볼 때 쓴다.
    function profileAfter(uid) {
      return getAfter(/databases/$(database)/documents/profiles/$(uid));
    }

    function numberAfter(n) {
      return getAfter(/databases/$(database)/documents/numbers/$(n));
    }

    function handleAfter(key) {
      return getAfter(/databases/$(database)/documents/handles/$(key));
    }

    // 쓰기가 끝난 뒤에도 그 사람 프로필이 이 번호를 쓰고 있는지
    function stillUses(uid, n) {
      return existsAfter(/databases/$(database)/documents/profiles/$(uid))
        && profileAfter(uid).data.tag == n;
    }

    // 번호나 예전 열쇠를 거둘 때 남기는 모습: 누구 것이었는지(uid)는 지우고 '안 씀' 표시만 남긴다.
    function retiring() {
      return request.resource.data.keys().hasOnly(['retired']) && request.resource.data.retired == true;
    }

    // 두 사람이 친구인지: 어느 쪽이 보냈든 수락된 요청이 하나 있으면 친구다.
    function req(id) {
      return /databases/$(database)/documents/requests/$(id);
    }

    function accepted(id) {
      return exists(req(id)) && get(req(id)).data.state == 'accepted';
    }

    function friends(a, b) {
      return accepted(a + '_' + b) || accepted(b + '_' + a);
    }


    // ===== 내 시간표 =====
    // 여러 기기의 시간표를 맞추려고 서버에 두는 사본이다. 나만 읽고 쓴다.
    // 교수 이름과 출발 지점은 앱이 처음부터 올리지 않는다.

    match /users/{uid} {
      allow read, write: if isMe(uid);

      match /timetables/{id} {
        allow read, delete: if isMe(uid);
        allow write: if isMe(uid)
          && request.resource.data.id == id
          && request.resource.data.sem is string
          && request.resource.data.updated is string;
      }
    }


    // ===== 관리자 표시 =====
    // 앱은 '내가 관리자인지'만 확인한다(웹 개발자 메뉴에 번호 바꿔 주기를 보일지). 쓰기는 콘솔에서만 한다.

    match /admins/{uid} {
      allow get: if isMe(uid);
    }


    // ===== 계정 번호 =====
    // numbers/{번호} = { uid }. 친구 추가 칸에 번호만 넣어도 그 사람을 찾을 수 있게 한다.
    // 번호 하나씩 찾는 것만 되고, 목록을 통째로 읽어 갈 수는 없다.
    // 쓰지 않게 된 번호는 지우지 않고 { retired: true } 로 남겨 다시는 남에게 주지 않는다.
    // 옛 초대 링크나 QR 코드가 엉뚱한 사람에게 가지 않게 하려는 것이다.

    match /numbers/{n} {
      allow get: if signedIn();

      // 내 번호는 같은 쓰기에서 내 프로필이 그 번호를 가리킬 때만 만든다.
      // 관리자는 번호를 바꿔 줄 때 그 사람 몫으로 새 번호를 만든다.
      allow create: if signedIn()
        && isNumber(n)
        && request.resource.data.keys().hasOnly(['uid'])
        && profileAfter(request.resource.data.uid).data.tag == n
        && (request.resource.data.uid == request.auth.uid || isAdmin());

      // 번호 거두기: 더는 아무 프로필도 그 번호를 쓰지 않을 때만. 계정을 지울 때(본인)와 번호를 바꿔 준 뒤의 옛 번호(관리자)가 그렇다.
      allow update: if signedIn()
        && retiring()
        && resource.data.get('uid', '') != ''
        && (resource.data.uid == request.auth.uid || isAdmin())
        && !stillUses(resource.data.uid, n);
    }


    // ===== 예전 열쇠 =====
    // handles/{닉네임#네 자리} = { uid }. 계정 번호가 생기기 전에 쓰던 방식이다.
    // 예전에 보낸 초대 링크가 계속 열리도록 남겨 둔다. 새로 만드는 건 아직 옛 판 앱을 쓰는 사람이 닉네임을 정할 때뿐이다.
    // 계정을 지우면 번호처럼 '안 씀'으로 남긴다.

    match /handles/{key} {
      allow get: if signedIn();

      // 옛 판 앱이 닉네임을 정할 때: 같은 쓰기에서 아직 번호가 없는(네 자리) 내 프로필이 이 열쇠를 가리켜야 한다.
      allow create: if signedIn()
        && key.matches('^[0-9a-z가-힣_]{2,12}#[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && profileAfter(request.auth.uid).data.handle == key
        && isOldTag(profileAfter(request.auth.uid).data.tag);

      // 내 예전 열쇠를 '안 씀'으로 거둔다(계정을 지울 때).
      allow update: if signedIn() && retiring() && resource.data.get('uid', '') == request.auth.uid;

      // 지우는 건 옛 판 앱이 계정을 지울 때(프로필도 같이 지우는 쓰기)뿐이다.
      // 닉네임을 바꾸며 열쇠를 푸는 건 막는다. 풀린 열쇠를 남이 받으면 옛 초대 링크가 그 사람에게 가기 때문이다.
      allow delete: if signedIn()
        && (resource == null
            || (resource.data.uid == request.auth.uid
                && !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))));
    }


    // ===== 프로필 =====
    // profiles/{uid} = { nick, tag(번호), updated, showSchool, school, handle(예전 열쇠, 있는 사람만) }
    // 친구 목록과 친구 찾기가 uid 로 하나씩 읽는다. 목록을 통째로 읽거나 닉네임으로 검색할 수는 없다.

    // '학교 계정' 표시는 본인이 보이게 두었고, 로그인한 메일이 확인된 snu.ac.kr 일 때만 켤 수 있다.
    function schoolOk(d) {
      return !d.get('school', false)
        || (d.get('showSchool', true) == true
            && request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', '').lower().matches('^[^@]+@snu[.]ac[.]kr$'));
    }

    // 본인이 쓰는 프로필이면 늘 지킬 것: 아는 칸만, 닉네임 2~12자, 학교 계정 표시 규칙
    function validProfile(d) {
      return d.keys().hasOnly(['nick', 'tag', 'handle', 'updated', 'showSchool', 'school'])
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 12
        && d.get('showSchool', true) is bool
        && d.get('school', false) is bool
        && schoolOk(d);
    }

    // 예전 열쇠(handle)는 처음 있던 그대로 두거나 아예 없어야 한다. 새로 달 수는 없다.
    function keepsOldKey() {
      return !('handle' in request.resource.data)
        || (resource != null && request.resource.data.handle == resource.data.get('handle', ''));
    }

    match /profiles/{uid} {
      allow get: if signedIn();

      // 지금 방식: 번호는 numbers 에 내 것으로 있어야 하고, 한번 받은 번호는 내가 바꿀 수 없다.
      // 예전 네 자리 번호에서 넘어올 때 딱 한 번만 새 번호를 받는다.
      allow create, update: if isMe(uid)
        && validProfile(request.resource.data)
        && isNumber(request.resource.data.tag)
        && numberAfter(request.resource.data.tag).data.uid == uid
        && (resource == null
            || resource.data.tag == request.resource.data.tag
            || isOldTag(resource.data.tag))
        && keepsOldKey();

      // 옛 판 앱이 쓰는 방식(닉네임#네 자리). 아직 번호를 받지 않은 프로필만 예전처럼 고칠 수 있다.
      // 한번 번호를 받은 프로필을 네 자리로 되돌릴 수는 없다.
      allow create, update: if isMe(uid)
        && validProfile(request.resource.data)
        && isOldTag(request.resource.data.tag)
        && handleAfter(request.resource.data.handle).data.uid == uid
        && (resource == null || isOldTag(resource.data.tag));

      // 관리자가 번호를 바꿔 줄 때: 번호(tag)와 고친 때(updated)만 바뀐다. 닉네임은 건드리지 못한다.
      // 새 번호는 같은 쓰기에서 이 사람 몫으로 만든 것이어야 한다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tag', 'updated'])
        && isNumber(request.resource.data.tag)
        && numberAfter(request.resource.data.tag).data.uid == uid;

      allow delete: if isMe(uid);
    }


    // ===== 친구 요청 =====
    // requests/{보낸 사람 uid}_{받은 사람 uid} = { from, to, state: 'pending' | 'accepted', created, updated }
    // 보낸 사람이 만들고, 받은 사람만 수락한다. 거절·취소·끊기는 둘 중 누구나 지울 수 있다.

    match /requests/{id} {
      // 하나 읽기는 문서 이름에 내 uid 가 들었을 때만. 없는 요청도 '없다'고 읽혀야 상대가 먼저 보냈는지 알 수 있다.
      allow get: if signedIn() && (id.split('_')[0] == request.auth.uid || id.split('_')[1] == request.auth.uid);
      allow list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      // 나를 막아 둔 사람에게는 보낼 수 없고, 상대가 이미 보낸 요청이 있으면 새로 만들지 않고 그걸 수락한다.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'state', 'created', 'updated'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.state == 'pending'
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to)/list/$(request.auth.uid))
        && !exists(req(request.resource.data.to + '_' + request.auth.uid));

      allow update: if signedIn() && resource.data.to == request.auth.uid && resource.data.state == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updated'])
        && request.resource.data.state == 'accepted';

      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }


    // ===== 차단 목록 =====
    // 내가 막은 사람 목록. 나만 보고 고친다. 상대는 자기가 막혔는지 알 수 없다(요청을 보내면 그냥 실패한다).

    match /blocks/{uid}/list/{other} {
      allow read, write: if isMe(uid);
    }


    // ===== 친구에게 보이는 시간표 =====
    // 학기마다 대표 시간표를 줄인 사본(강좌 이름·시간·강의실, 직접 넣은 일정은 제목과 시간만). 나와 친구만 읽는다.

    match /shared/{uid}/terms/{sem} {
      allow read: if isMe(uid) || (signedIn() && friends(request.auth.uid, uid));
      allow write: if isMe(uid) && (request.resource == null || request.resource.data.sem == sem);
    }
  }
}
